// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnrolmentStatus {
  ENROLLED
  DEFERRED
  WITHDRAWN
  COMPLETED
}

model Programme {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(150)
  standardFee Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  students Student[]
  modules  Module[]
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(20)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(false)

  students Student[]
}

model Student {
  id             String          @id @default(uuid())
  studentId      String          @unique @db.VarChar(30)
  fullName       String          @db.VarChar(150)
  email          String          @unique @db.VarChar(254)
  dateOfBirth    DateTime        @db.Date
  programmeId    String
  academicYearId String
  status         EnrolmentStatus @default(ENROLLED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  programme    Programme    @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  studentFee   StudentFee?
  submissions  Submission[]

  @@index([fullName])
  @@index([programmeId, status])
  @@index([academicYearId])
}

model StudentFee {
  id        String   @id @default(uuid())
  studentId String   @unique
  amountDue Decimal  @db.Decimal(12, 2)
  dueDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payments Payment[]
}

model Payment {
  id              String   @id @default(uuid())
  studentFeeId    String
  amount          Decimal  @db.Decimal(12, 2)
  paidAt          DateTime @default(now())
  referenceNumber String   @unique @db.VarChar(100)
  createdAt       DateTime @default(now())

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Restrict)

  @@index([studentFeeId, paidAt])
}

model Module {
  id          String   @id @default(uuid())
  programmeId String
  code        String   @db.VarChar(30)
  title       String   @db.VarChar(150)
  createdAt   DateTime @default(now())

  programme   Programme    @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  assessments Assessment[]

  @@unique([programmeId, code])
}

model Assessment {
  id        String   @id @default(uuid())
  moduleId  String
  title     String   @db.VarChar(200)
  deadline  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@index([moduleId, deadline])
}

model Submission {
  id           String   @id @default(uuid())
  studentId    String
  assessmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  assessment Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  versions   SubmissionVersion[]
  result     AssessmentResult?

  @@unique([studentId, assessmentId])
  @@index([assessmentId, studentId])
}

model SubmissionVersion {
  id            String   @id @default(uuid())
  submissionId  String
  versionNumber Int
  fileName      String   @db.VarChar(255)
  storageKey    String   @unique @db.VarChar(500)
  mimeType      String   @db.VarChar(100)
  fileSize      Int
  submittedAt   DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, versionNumber])
  @@index([submissionId, submittedAt])
}

model AssessmentResult {
  id           String   @id @default(uuid())
  submissionId String   @unique
  grade        Decimal  @db.Decimal(5, 2)
  isPublished  Boolean  @default(false)
  gradedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
}
